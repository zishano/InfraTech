        <mxCell id="state_prefill" value="PREFILL (start_pos=0)&#10;cutoff=T−T%128; completed=floor(T/128)&#10;Keep incomplete suffix for decode&#10;Keep only current incomplete 128-token window" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
