        </mxCell>
        <mxCell id="state_decode" value="DECODE (position p)&#10;Write raw KV / gate at slot p%128&#10;Emit only if (p+1)%128==0&#10;Write cache slot floor(p/128); RoPE pos=p+1−128" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2660" y="4600" width="1250" height="220" />
        </mxCell>
        <mxCell id="state_window1" value="Compressed j=0&#10;Tokens0…127 → one512-dim vector&#10;APE has128 slot rows; softmax is per-channel over128 tokens&#10;Emission p=127; RoPE position0; stored at compressed slot0" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=29;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="4880" width="1820" height="240" />
        </mxCell>
        <mxCell id="state_window2" value="Compressed j=1&#10;Tokens128…255 → a DIFFERENT512-dim vector&#10;No token overlap with j0; no previous-window Ca branch&#10;Emission p=255; RoPE position128; stored at compressed slot1" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=29;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2010" y="4880" width="1900" height="240" />
        </mxCell>
        <mxCell id="state_move" value="Before boundary p=127/255/…: update partial-window state only. At boundary: compress128 slots and append one KV entry.&#10;All earlier completed entries remain in cache and are indexed causally. No learned retrieval network and no top-512 cap." style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=29;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="5200" width="3840" height="200" />
