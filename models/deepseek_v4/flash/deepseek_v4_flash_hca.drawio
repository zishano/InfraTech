        <mxCell id="state_shapes" value="MAIN runtime buffers (not checkpoint)&#10;kv_state / score_state: [B,128,512]&#10;KV init=0; gate init=-infinity&#10;No indexer state or indexer KV bank" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
