        <mxCell id="state_prefill" value="Prefill → keep partial window" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#536580;align=center;verticalAlign=middle;spacing=3;fillColor=none;strokeColor=none;architectureDecoration=1;" vertex="1" parent="1" tooltip="PREFILL (start_pos=0)&#10;cutoff=T−T%4; completed=floor(T/4)&#10;Keep incomplete suffix for decode&#10;Keep last complete raw window; read its Ca half later">
          <mxGeometry as="geometry" x="60" y="1850" width="350" height="34" />
        </mxCell>
        <mxCell id="state_decode" value="Decode → emit every 4 tokens" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#536580;align=center;verticalAlign=middle;spacing=3;fillColor=none;strokeColor=none;architectureDecoration=1;" vertex="1" parent="1" tooltip="DECODE (position p)&#10;Write raw KV / gate at slot 4+(p%4)&#10;Emit only if (p+1)%4==0&#10;Write cache slot floor(p/4); RoPE pos=p+1−4">
          <mxGeometry as="geometry" x="1790" y="1670" width="490" height="34" />
        </mxCell>
        <mxCell id="state_window1" value="Previous raw window [4,1024]" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#536580;align=center;verticalAlign=middle;spacing=3;fillColor=none;strokeColor=none;architectureDecoration=1;" vertex="1" parent="1" tooltip="Compressed j=1 (emitted after token7)&#10;VALUES: [Ca0 Ca1 Ca2 Ca3 | Cb4 Cb5 Cb6 Cb7]&#10;GATES:  [Za0 Za1 Za2 Za3 | Zb4 Zb5 Zb6 Zb7] + per-slot APE&#10;Softmax8 PER CHANNEL; output RoPE position4">
          <mxGeometry as="geometry" x="610" y="1665" width="410" height="34" />
        </mxCell>
        <mxCell id="state_window2" value="Current raw window [4,1024]" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#536580;align=center;verticalAlign=middle;spacing=3;fillColor=none;strokeColor=none;architectureDecoration=1;" vertex="1" parent="1" tooltip="Compressed j=2 (emitted after token11)&#10;VALUES: [Ca4 Ca5 Ca6 Ca7 | Cb8 Cb9 Cb10 Cb11]&#10;Same token can supply Cb to j and Ca to j+1&#10;First j=0: missing previous half has value0 / gate−infinity">
          <mxGeometry as="geometry" x="1110" y="1665" width="410" height="34" />
        </mxCell>
        <mxCell id="state_move" value="Cat (previous Ca, current Cb)" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#536580;align=center;verticalAlign=middle;spacing=3;fillColor=none;strokeColor=none;architectureDecoration=1;" vertex="1" parent="1" tooltip="On a completed decode stride: copy current raw window into previous-window state. Read Ca from previous slots and Cb from current slots.&#10;A partial stride does NOT create a new compressed entry. Existing entries remain readable; Indexer top-k does not delete them.">
          <mxGeometry as="geometry" x="820" y="1910" width="500" height="34" />
        </mxCell>
