        <mxCell id="state_shapes" value="kv_state / score_state&#10;[8,1024]" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=4;strokeColor=#8797fa;strokeWidth=1;fillColor=#8797fa;" vertex="1" parent="1" tooltip="MAIN runtime buffers (not checkpoint)&#10;kv_state / score_state: [B,8,1024]&#10;KV init=0; gate init=-infinity&#10;Indexer owns separate [B,8,256] buffers">
          <mxGeometry as="geometry" x="70" y="2760.0" width="1170" height="132.0" />
        </mxCell>
        <mxCell id="state_prefill" value="Prefill → Buffer remainder" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=4;strokeColor=#8797fa;strokeWidth=1;fillColor=#8797fa;" vertex="1" parent="1" tooltip="PREFILL (start_pos=0)&#10;cutoff=T−T%4; completed=floor(T/4)&#10;Keep incomplete suffix for decode&#10;Keep last complete raw window; read its Ca half later">
          <mxGeometry as="geometry" x="1370" y="2760.0" width="1170" height="132.0" />
        </mxCell>
        <mxCell id="state_decode" value="Update → Emit every 4 tokens" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=4;strokeColor=#8797fa;strokeWidth=1;fillColor=#8797fa;" vertex="1" parent="1" tooltip="DECODE (position p)&#10;Write raw KV / gate at slot 4+(p%4)&#10;Emit only if (p+1)%4==0&#10;Write cache slot floor(p/4); RoPE pos=p+1−4">
          <mxGeometry as="geometry" x="2660" y="2760.0" width="1250" height="132.0" />
        </mxCell>
        <mxCell id="state_window1" value="prev Ca [4,512]" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=4;strokeColor=#8797fa;strokeWidth=1;fillColor=#8797fa;" vertex="1" parent="1" tooltip="Compressed j=1 (emitted after token7)&#10;VALUES: [Ca0 Ca1 Ca2 Ca3 | Cb4 Cb5 Cb6 Cb7]&#10;GATES:  [Za0 Za1 Za2 Za3 | Zb4 Zb5 Zb6 Zb7] + per-slot APE&#10;Softmax8 PER CHANNEL; output RoPE position4">
          <mxGeometry as="geometry" x="70" y="2928.0" width="1820" height="144.0" />
        </mxCell>
        <mxCell id="state_window2" value="cur Cb [4,512]" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=4;strokeColor=#8797fa;strokeWidth=1;fillColor=#8797fa;" vertex="1" parent="1" tooltip="Compressed j=2 (emitted after token11)&#10;VALUES: [Ca4 Ca5 Ca6 Ca7 | Cb8 Cb9 Cb10 Cb11]&#10;Same token can supply Cb to j and Ca to j+1&#10;First j=0: missing previous half has value0 / gate−infinity">
          <mxGeometry as="geometry" x="2010" y="2928.0" width="1900" height="144.0" />
        </mxCell>
        <mxCell id="state_move" value="prev ← current (on stride boundary)" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=4;strokeColor=#8797fa;strokeWidth=1;fillColor=#8797fa;" vertex="1" parent="1" tooltip="On a completed decode stride: copy current raw window into previous-window state. Read Ca from previous slots and Cb from current slots.&#10;A partial stride does NOT create a new compressed entry. Existing entries remain readable; Indexer top-k does not delete them.">
          <mxGeometry as="geometry" x="70" y="3120.0" width="3840" height="120.0" />
        </mxCell>
