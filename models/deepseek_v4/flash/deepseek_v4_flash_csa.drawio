        <mxCell id="attn_gather" value="sparse_attn kernel: tiles of 64 index entries&#10;If idx!=-1: gather shared kv[idx] (both K and V)&#10;Q·K / sqrt(512), FP32 score accumulators&#10;If idx==-1: zero KV and -infinity score" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
