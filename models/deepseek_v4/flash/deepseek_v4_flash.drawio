        </mxCell>
        <mxCell id="attn_gather" value="Gather (KV) → QKᵀ / √512" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#203148;align=center;verticalAlign=middle;spacing=5;strokeColor=#ce8220;strokeWidth=1.2;fillColor=#fff7e9;fillColor=#ce8220;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1" tooltip="sparse_attn kernel: tiles of 64 index entries&#10;If idx!=-1: gather shared kv[idx] (both K and V)&#10;Q·K / sqrt(512), FP32 score accumulators&#10;If idx==-1: zero KV and -infinity score">
