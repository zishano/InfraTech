        <mxCell id="state_window2" value="Compressed j=1&#10;Tokens128…255 → a DIFFERENT512-dim vector&#10;No token overlap with j0; no previous-window Ca branch&#10;Emission p=255; RoPE position128; stored at compressed slot1" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=29;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
