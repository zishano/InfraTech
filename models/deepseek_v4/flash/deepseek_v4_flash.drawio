        </mxCell>
        <mxCell id="attn_indices" value="Concatenate [local-window indices | port I]&#10;Prefill offset=T; decode compressed offset=128&#10;Convert to int32; -1 stays invalid" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2670" y="1870" width="1240" height="165" />
        </mxCell>
        <mxCell id="attn_gather" value="sparse_attn kernel: tiles of 64 index entries&#10;If idx!=-1: gather shared kv[idx] (both K and V)&#10;Q·K / sqrt(512), FP32 score accumulators&#10;If idx==-1: zero KV and -infinity score" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2730" y="1550" width="1100" height="190" />
        </mxCell>
        <mxCell id="attn_softmax" value="Online stable softmax: update running max and sum&#10;Denominator = sum_j exp(score_j-max) + exp(sink_h-max)&#10;The sink changes normalization ONLY; it has no value vector" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2730" y="1300" width="1100" height="190" />
        </mxCell>
        <mxCell id="attn_sink" value="Learned&#10;sink_h&#10;One per&#10;Q head" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3850" y="1300" width="100" height="190" />
        </mxCell>
        <mxCell id="attn_values" value="Numerator: sum_j exp(score_j-max) × kv[idx_j]&#10;Divide by denominator; FP32 accumulator → BF16 output&#10;Result [B,T,64,512]" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2730" y="1090" width="1100" height="150" />
        </mxCell>
        <mxCell id="attn_inverse" value="Conjugate RoPE (inverse=True) on output trailing64&#10;At the CURRENT query position; content448 unchanged" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
