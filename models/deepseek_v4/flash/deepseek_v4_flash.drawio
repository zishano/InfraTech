        <mxCell id="state_prefill" value="Prefill → Buffer remainder" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=4;strokeColor=#8797fa;strokeWidth=1;fillColor=#8797fa;" vertex="1" parent="1" tooltip="PREFILL (start_pos=0)&#10;cutoff=T−T%128; completed=floor(T/128)&#10;Keep incomplete suffix for decode&#10;Keep only current incomplete 128-token window">
          <mxGeometry as="geometry" x="1370" y="2760.0" width="1170" height="132.0" />
        </mxCell>
        <mxCell id="state_decode" value="Update → Emit every 128 tokens" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=4;strokeColor=#8797fa;strokeWidth=1;fillColor=#8797fa;" vertex="1" parent="1" tooltip="DECODE (position p)&#10;Write raw KV / gate at slot p%128&#10;Emit only if (p+1)%128==0&#10;Write cache slot floor(p/128); RoPE pos=p+1−128">
          <mxGeometry as="geometry" x="2660" y="2760.0" width="1250" height="132.0" />
        </mxCell>
        <mxCell id="state_window1" value="Tokens 0…127 → KV₀" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=4;strokeColor=#8797fa;strokeWidth=1;fillColor=#8797fa;" vertex="1" parent="1" tooltip="Compressed j=0&#10;Tokens0…127 → one512-dim vector&#10;APE has128 slot rows; softmax is per-channel over128 tokens&#10;Emission p=127; RoPE position0; stored at compressed slot0">
          <mxGeometry as="geometry" x="70" y="2928.0" width="1820" height="144.0" />
        </mxCell>
        <mxCell id="state_window2" value="Tokens 128…255 → KV₁" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=4;strokeColor=#8797fa;strokeWidth=1;fillColor=#8797fa;" vertex="1" parent="1" tooltip="Compressed j=1&#10;Tokens128…255 → a DIFFERENT512-dim vector&#10;No token overlap with j0; no previous-window Ca branch&#10;Emission p=255; RoPE position128; stored at compressed slot1">
          <mxGeometry as="geometry" x="2010" y="2928.0" width="1900" height="144.0" />
        </mxCell>
        <mxCell id="state_move" value="Append one KV every 128 tokens" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=4;strokeColor=#8797fa;strokeWidth=1;fillColor=#8797fa;" vertex="1" parent="1" tooltip="Before boundary p=127/255/…: update partial-window state only. At boundary: compress128 slots and append one KV entry.&#10;All earlier completed entries remain in cache and are indexed causally. No learned retrieval network and no top-512 cap.">
