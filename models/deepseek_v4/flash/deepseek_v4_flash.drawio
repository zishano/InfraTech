        <mxCell id="attn_bank" value="Physical KV bank (K=V)&#10;Prefill: cat current KV[T] and complete compressed KV[Nc]&#10;Decode: [ring128 | compressed cache]; compressor aliases right slice" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
