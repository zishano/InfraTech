          <mxGeometry as="geometry" x="700" y="3860" width="500" height="120" />
        </mxCell>
        <mxCell id="comp_split" value="Reshape [B,N,4,1024] → Ca / Cb&#10;Ca = first512; Cb = last512" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#e0f4ef;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="3640" width="500" height="160" />
        </mxCell>
        <mxCell id="comp_ape" value="Add learned APE / position bias&#10;shape [4,1024]&#10;Prefill: slot in window; decode: p&#10;% 4" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#e0f4ef;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="3640" width="500" height="160" />
        </mxCell>
        <mxCell id="comp_gate_split" value="Split biased gate channels Za / Zb&#10;Same Ca/Cb feature layout as KV" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#e0f4ef;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="3430" width="500" height="150" />
        </mxCell>
        <mxCell id="comp_value_window" value="VALUE WINDOW: [Ca_(j-1), Cb_j]&#10;[B,N,8,512], stride4, effective&#10;width8&#10;First window: missing Ca values =&#10;0" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#e0f4ef;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="3230" width="500" height="190" />
        </mxCell>
        <mxCell id="comp_gate_window" value="GATE WINDOW: [Za_(j-1), Zb_j]&#10;[B,N,8,512]&#10;Missing first-window gates =&#10;-infinity" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#e0f4ef;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="3200" width="500" height="190" />
        </mxCell>
        <mxCell id="comp_softmax" value="FP32 softmax over 8 TOKEN slots&#10;Independently for each of 512&#10;channels&#10;P = softmax(Z_window, dim=tokens)" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#e0f4ef;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="2980" width="500" height="160" />
        </mxCell>
        <mxCell id="comp_mul" value="Elementwise product: P ⊙ C_window&#10;Shape [B,N,8,512]&#10;KV values bypass softmax" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#e0f4ef;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="2760" width="1130" height="150" />
        </mxCell>
        <mxCell id="comp_sum" value="Sum over 8 token slots&#10;c_j[d] = sum_s P[j,s,d] × C[j,s,d]&#10;Result [B,N,512] — NOT pooling across channels" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#e0f4ef;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="2550" width="1130" height="150" />
        </mxCell>
        <mxCell id="comp_complete" value="Emit only a completed 4-token stride&#10;Prefill: cutoff=T−(T%4); decode: (p+1)%4==0&#10;Otherwise return None; keep buffered state" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=26;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#e0f4ef;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="2350" width="1130" height="145" />
        </mxCell>
        <mxCell id="comp_norm" value="Cast pooled vector back to input dtype&#10;Learned RMSNorm over 512 channels" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#e0f4ef;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="2160" width="1130" height="120" />
        </mxCell>
        <mxCell id="comp_nope" value="Content 448 dims&#10;FP8 QAT simulation, block64&#10;Simulated values remain BF16" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#e0f4ef;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1940" width="500" height="155" />
        </mxCell>
        <mxCell id="comp_rope" value="Trailing 64 dims: partial RoPE&#10;Prefill position=4j&#10;Decode position=p+1−4&#10;RoPE values remain BF16" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#e0f4ef;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="1940" width="500" height="155" />
        </mxCell>
        <mxCell id="comp_concat" value="Reassemble content448 | RoPE64&#10;One shared KV vector [512] per complete stride" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#e0f4ef;" vertex="1" parent="1">
