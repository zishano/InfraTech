        <mxCell id="attn_indices" value="Concatenate [local-window indices | port I]&#10;Prefill offset=T; decode compressed offset=128&#10;Convert to int32; -1 stays invalid" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2670" y="1870" width="1240" height="165" />
        </mxCell>
        <mxCell id="attn_gather" value="sparse_attn kernel: tiles of 64 index entries&#10;If idx!=-1: gather shared kv[idx] (both K and V)&#10;Q·K / sqrt(512), FP32 score accumulators&#10;If idx==-1: zero KV and -infinity score" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2730" y="1550" width="1100" height="190" />
        </mxCell>
        <mxCell id="attn_softmax" value="Online stable softmax: update running max and sum&#10;Denominator = sum_j exp(score_j-max) + exp(sink_h-max)&#10;The sink changes normalization ONLY; it has no value vector" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2730" y="1300" width="1100" height="190" />
        </mxCell>
        <mxCell id="attn_sink" value="Learned&#10;sink_h&#10;One per&#10;Q head" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3850" y="1300" width="100" height="190" />
        </mxCell>
        <mxCell id="attn_values" value="Numerator: sum_j exp(score_j-max) × kv[idx_j]&#10;Divide by denominator; FP32 accumulator → BF16 output&#10;Result [B,T,64,512]" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2730" y="1090" width="1100" height="150" />
        </mxCell>
        <mxCell id="attn_inverse" value="Conjugate RoPE (inverse=True) on output trailing64&#10;At the CURRENT query position; content448 unchanged" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2730" y="900" width="1100" height="130" />
        </mxCell>
        <mxCell id="attn_oa" value="Group 64×512 heads into 8 groups&#10;W_o_a: per-group 4096 → 1024 (einsum)" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2730" y="740" width="1100" height="110" />
        </mxCell>
        <mxCell id="attn_ob" value="Flatten 8×1024 → W_o_b → 4096&#10;TP output all-reduce when needed" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#fff0dc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2730" y="600" width="1100" height="100" />
        </mxCell>
        <mxCell id="attn_output" value="OUTPUT: attention hidden states [B,T,4096]" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=26;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#f3f6fa;fillColor=none;strokeColor=none;architectureDecoration=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2670" y="535" width="1240" height="60" />
        </mxCell>
        <mxCell id="states" value="" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;fillColor=#ffffff;dashed=1;architectureDecoration=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="4470" width="3940" height="1050" />
        </mxCell>
        <mxCell id="states_title" value="PREFILL / DECODE STATE + WINDOW LAYOUT — temporal state, not an extra network layer" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=30;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;architectureDecoration=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="4485" width="3910" height="75" />
        </mxCell>
        <mxCell id="state_shapes" value="MAIN runtime buffers (not checkpoint)&#10;kv_state / score_state: [B,8,1024]&#10;KV init=0; gate init=-infinity&#10;Indexer owns separate [B,8,256] buffers" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="4600" width="1170" height="220" />
        </mxCell>
        <mxCell id="state_prefill" value="PREFILL (start_pos=0)&#10;cutoff=T−T%4; completed=floor(T/4)&#10;Keep incomplete suffix for decode&#10;Keep last complete raw window; read its Ca half later" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1370" y="4600" width="1170" height="220" />
        </mxCell>
        <mxCell id="state_decode" value="DECODE (position p)&#10;Write raw KV / gate at slot 4+(p%4)&#10;Emit only if (p+1)%4==0&#10;Write cache slot floor(p/4); RoPE pos=p+1−4" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2660" y="4600" width="1250" height="220" />
        </mxCell>
        <mxCell id="state_window1" value="Compressed j=1 (emitted after token7)&#10;VALUES: [Ca0 Ca1 Ca2 Ca3 | Cb4 Cb5 Cb6 Cb7]&#10;GATES:  [Za0 Za1 Za2 Za3 | Zb4 Zb5 Zb6 Zb7] + per-slot APE&#10;Softmax8 PER CHANNEL; output RoPE position4" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=29;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="4880" width="1820" height="240" />
        </mxCell>
        <mxCell id="state_window2" value="Compressed j=2 (emitted after token11)&#10;VALUES: [Ca4 Ca5 Ca6 Ca7 | Cb8 Cb9 Cb10 Cb11]&#10;Same token can supply Cb to j and Ca to j+1&#10;First j=0: missing previous half has value0 / gate−infinity" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=29;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2010" y="4880" width="1900" height="240" />
        </mxCell>
        <mxCell id="state_move" value="On a completed decode stride: copy current raw window into previous-window state. Read Ca from previous slots and Cb from current slots.&#10;A partial stride does NOT create a new compressed entry. Existing entries remain readable; Indexer top-k does not delete them." style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=29;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="5200" width="3840" height="200" />
        </mxCell>
