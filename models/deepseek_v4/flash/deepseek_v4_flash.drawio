        <mxCell id="state_decode" value="DECODE (position p)&#10;Write raw KV / gate at slot p%128&#10;Emit only if (p+1)%128==0&#10;Write cache slot floor(p/128); RoPE pos=p+1−128" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=27;fontColor=#16283d;align=center;verticalAlign=middle;spacing=10;strokeColor=#34465a;fillColor=#eee7f7;" vertex="1" parent="1">
